# Backend Environment Variables
# Copy to .env and fill with real values (NEVER commit .env!)

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://loanuser:loanpass123@localhost:5432/loan_default_db

# JWT Security Settings
SECRET_KEY=make-this-a-random-string-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mail Configuration (fastapi-mail)
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False